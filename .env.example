VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_HQ_WEEK_AT_A_GLANCE_CSV_URL=https://docs.google.com/spreadsheets/d/e/REPLACE/pub?gid=REPLACE&single=true&output=csv

# ── Operations sheet tab discovery (optional but recommended) ──────────────
# When set, the browser calls the Google Sheets API v4 directly to enumerate
# every tab inside Purchase / Payment Request sheets. Without this (and
# without the `list-sheet-tabs` Edge Function deployed), only the single
# CSV-exported tab is summarised.
#
# Setup:
#   1. https://console.cloud.google.com → APIs & Services → Library →
#      enable "Google Sheets API"
#   2. APIs & Services → Credentials → Create credentials → API key
#   3. Restrict the key:
#      - Application restrictions: HTTP referrers
#        Allowed referrers: https://the-roof-hrm.vercel.app/*  ,  http://localhost:5173/*
#      - API restrictions: only "Google Sheets API"
#   4. Paste the key below.
#
# Sheets must be shared as "Anyone with the link can view" for the API key
# to read them.
VITE_GOOGLE_API_KEY=your_browser_restricted_google_api_key_here

# Web Push (VAPID) — generate correct keys with:
#   npx web-push generate-vapid-keys
# Use the Public Key output EXACTLY (base64url format, ~88 chars). Do NOT use hex.
# Also set in Supabase: supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...
VITE_VAPID_PUBLIC_KEY=your_base64url_public_key_here

# ── Reservation Reminder Notifications ─────────────────────────────────────
# The `reservation-reminders` Edge Function sends 1-hour-before reminders
# (in-app bell + Web Push) to all owners and managers for confirmed reservations.
#
# HOW TO ACTIVATE (one-time setup):
#
# 1. Deploy the Edge Function:
#      supabase functions deploy reservation-reminders
#
# 2. Run the SQL migration to fix timezone support in get_reservations_for_reminder:
#      supabase db push
#    (or apply supabase/migrations/20260228000002_fix_reminder_function.sql manually)
#
# 3. (Optional) Set a shared secret so only your cron service can trigger it:
#      supabase secrets set CRON_SECRET=your_random_secret_here
#
# 4. Create a free cron job at https://cron-job.org (or similar) to POST every 15 min:
#      URL:     https://<your-project-ref>.supabase.co/functions/v1/reservation-reminders
#      Method:  POST
#      Headers: Authorization: Bearer <SUPABASE_SERVICE_ROLE_KEY>
#               x-cron-secret: <CRON_SECRET>   (only if step 3 was done)
#
# The function marks each processed reservation with reminder_sent=true so
# it will never fire twice for the same reservation.
# CRON_SECRET=your_random_secret_here   # optional — set as Supabase secret, not here
